{
  "name": "@richardmcquiston01/error-log-adapter",
  "version": "0.3.0",
  "description": "Dependency-free TypeScript error logging with pluggable adapters for console, webhook, MongoDB, Postgres, MySQL, SQLite, Redis, S3, IndexedDB, Web Storage, and file sinks.",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "homepage": "https://github.com/RichardMcQuiston01/error-log-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/error-log-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/error-log-adapter/issues"
  },
  "keywords": [
    "typescript",
    "error-logging",
    "logger",
    "adapter-pattern",
    "error-handling",
    "webhook",
    "mongodb",
    "sqlite",
    "postgres",
    "mysql",
    "redis",
    "s3",
    "indexeddb",
    "ndjson",
    "zero-dependencies"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:live": "vitest run s3-error-adapter.live",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@types/node": "^20.0.0",
    "prettier": "^3.3.0",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
