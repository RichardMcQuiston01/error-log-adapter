{
  "name": "@richardmcquiston01/error-log-adapter",
  "version": "0.15.1",
  "description": "Dependency-free TypeScript error logging with pluggable adapters for console, webhook, MongoDB, Postgres, MySQL, SQLite, Redis, S3, IndexedDB, Web Storage, and file sinks.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "homepage": "https://github.com/RichardMcQuiston01/error-log-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/error-log-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/error-log-adapter/issues"
  },
  "keywords": [
    "typescript",
    "error-logging",
    "logger",
    "adapter-pattern",
    "error-handling",
    "webhook",
    "mongodb",
    "sqlite",
    "postgres",
    "mysql",
    "redis",
    "s3",
    "indexeddb",
    "ndjson",
    "zero-dependencies"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.mjs",
      "require": "./dist/kit.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "bun run build",
    "test": "vitest run",
    "test:live": "vitest run .live.test",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.scripts.json && bun run --filter './packages/*' typecheck",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "build:packages": "bun run --filter './packages/*' build"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1152.0",
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/client-sns": "^3.1152.0",
    "@aws-sdk/client-sqs": "^3.1152.0",
    "@google-cloud/firestore": "^9.3.1",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.23.1",
    "@types/semver": "^7.8.0",
    "@types/ws": "^8.18.2",
    "firebase-admin": "^14.5.0",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.6",
    "pg": "^8.23.1",
    "prettier": "^3.3.0",
    "redis": "^6.3.0",
    "semver": "^7.8.5",
    "tsup": "^8.5.1",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "ws": "^8.22.0"
  },
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  }
}
