{
  "name": "@richardmcquiston01/error-log-adapter-couchdb",
  "version": "0.1.0",
  "description": "CouchDB adapter for @richardmcquiston01/error-log-adapter: stores each error as a document whose _id is the entry id, so retries never duplicate.",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston01@gmail.com>",
  "homepage": "https://github.com/RichardMcQuiston01/error-log-adapter/tree/main/packages/couchdb#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/error-log-adapter.git",
    "directory": "packages/couchdb"
  },
  "bugs": {
    "url": "https://github.com/RichardMcQuiston01/error-log-adapter/issues"
  },
  "keywords": [
    "typescript",
    "error-logging",
    "logger",
    "adapter-pattern",
    "couchdb",
    "nano"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@richardmcquiston01/error-log-adapter": ">=0.15.0"
  },
  "devDependencies": {
    "nano": "^11.0.7"
  },
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  }
}
